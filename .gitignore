# ===================================================================
# Comments and Documentation
# ===================================================================
# Ignore files that may contain sensitive information or are specific
# to the local development environment.

# ===================================================================
# Logs and Reports
#
# General log files and reports generated by various tools.
# ===================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage reports from Jest/Vitest
coverage/
.nyc_output/

# ===================================================================
# Dependencies
#
# Packages installed by dependency managers.
# ===================================================================
node_modules/

# ===================================================================
# Build and Cache
#
# Compiled files, build artifacts, and cache directories.
# ===================================================================
# Build directories
dist/
dist-ssr/
build/

# TypeScript cache for incremental builds
*.tsbuildinfo

# Vite cache
.vite/

# Screenshots Vitest takes when a browser test fails
__screenshots__/

# ===================================================================
# Environment Files
#
# Files with local environment variables.
# It is recommended to keep a .env.example file in the repository as a template.
# ===================================================================
.env
.env.local
.env.*.local
*.local
.eslintcache

# ===================================================================
# IDE and Code Editor Files
#
# Configuration and temporary files created by IDEs.
# ===================================================================
# JetBrains (WebStorm, IntelliJ IDEA)
.idea/

# Visual Studio Code (keeping shared settings)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Visual Studio
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===================================================================
# System Files
#
# System files that should not be committed to the repository.
# ===================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# ===================================================================
# Documentation site
#
# Pages, the API reference and the build of website/ are generated
# by `npm run docs:build`; never edit or commit them.
# ===================================================================
website/.content/
website/.vitepress/cache/
website/.vitepress/dist/

# Copied from the root by prepack, so the published package carries the license
packages/*/LICENSE
