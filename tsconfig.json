{
  "compilerOptions": {
    /* Base Options */
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,

    /* Bundler & D-Lib Options */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "declarationMap": true,

    /* Linting & Strictness */
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "packages",
    "paths": {
      "@Http": ["http/src/index.ts"],
      "@Http/*": ["http/src/*"],
      "@metapraxis/jext-http": ["http/index.ts"],
      "@metapraxis/jext-collection": ["collection/index.ts"],
      "@Collection/*": ["collection/src/*"]
    }
  },
  "include": ["packages"],
  "exclude": ["node_modules", "dist", "**/.gitkeep", "**/*.md"]
}
