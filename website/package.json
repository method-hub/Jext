{
  "name": "jext-website",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site of Jext, built from the packages: VitePress pages and a TypeDoc API reference",
  "type": "module",
  "scripts": {
    "check": "node scripts/collect.mjs --check",
    "api": "typedoc --options typedoc.json",
    "collect": "node scripts/collect.mjs",
    "dev": "npm run api && npm run collect && vitepress dev",
    "build": "npm run check && npm run api && npm run collect && vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "mermaid": "^10.9.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "dependencies": {
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-jsdoc": "^3.7.1",
    "npm-run-all": "^1.1.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
